# Copy to .env.local and fill in. .env.local is gitignored: never commit it.

# --- Mail (Resend) -------------------------------------------------------
# Without a key the contact form and the feedback form answer with a
# configuration error instead of sending. The domain akilisawa.com must also
# be verified as a sending domain at Resend before anything is delivered:
# see docs/resend-domain-verification.md.
RESEND_API_KEY=
CONTACT_TO_EMAIL=smile@akilisawa.com
CONTACT_FROM_EMAIL=smile@akilisawa.com

# Where a high-severity Sawa AI safety signal is delivered. Defaults to
# CONTACT_TO_EMAIL. Set SAWA_ESCALATION_ENABLED to false to switch the
# escalation path off entirely.
SAWA_ESCALATION_TO=smile@akilisawa.com
SAWA_ESCALATION_ENABLED=true

# --- Sawa AI model provider ----------------------------------------------
# nvidia or openai. The matching three variables below are required together.
SAWA_MODEL_PROVIDER=nvidia

NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=

# Only used when SAWA_MODEL_PROVIDER is openai.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Optional. Falls back to the module default.
# SAWA_PROVIDER_TIMEOUT_MS=
